---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/pc.css';
import { profile, experience, skills, formSteps, motionSteps } from '../data/portfolio';
const arrow = 'M5 15 15 5M5 5h10v10';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Raghav Gupta | AI &amp; Software Engineering</title>
    <meta name="description" content={profile.introduction} />
    <meta name="theme-color" content="#111213" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/images/pc-19/overview-desktop.webp" media="(min-width: 1000px)" />
    <link rel="preload" as="image" href="/images/pc-19/overview-mobile.webp" media="(max-width: 999px)" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="pc-stage" aria-hidden="true">
      <div class="pc-studio-floor"></div>
      <picture id="pc-poster"><source media="(max-width: 999px)" srcset="/images/pc-19/overview-mobile.webp" /><img src="/images/pc-19/overview-desktop.webp" alt="" fetchpriority="high" width="1280" height="1280" /></picture>
      <canvas id="pc-canvas"></canvas>
    </div>
    <header class="pc-header">
      <a class="pc-wordmark" href="#overview" aria-label="Raghav Gupta, overview">Raghav Gupta</a>
      <nav id="pc-nav" aria-label="Main navigation">
        <a href="#experience" data-nav-chapter="experience">Experience</a>
        <a href="#projects" data-nav-chapter="projects">Projects</a>
        <a href="#skills" data-nav-chapter="skills">Skills</a>
        <a href="#contact" data-nav-chapter="contact">Contact</a>
      </nav>
      <button id="pc-motion" type="button" aria-pressed="false" hidden>Motion on</button>
    </header>
    <main id="main" tabindex="-1">
      <section id="overview" class="pc-hero" data-story="0" aria-labelledby="profile-title">
        <h1 id="profile-title">Raghav <span>Gupta</span></h1>
        <div class="pc-hero-copy">
          <p class="pc-focus">AI &amp; Software<br class="desktop-break" /> Engineering</p>
          <p class="pc-introduction">Computer Engineering student<br class="desktop-break" /> at the University of Waterloo.</p>
          <div class="pc-hero-actions">
            <a href="#experience">View experience <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h14m-5-5 5 5-5 5" /></svg></a>
            <a href="#projects">Selected projects <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h14m-5-5 5 5-5 5" /></svg></a>
          </div>
        </div>
        <a class="pc-hero-email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="pc-hero-availability"><p>Seeking Winter 2027 co-op</p><span>Four months · AI &amp; software engineering</span></div>
      </section>
      <section id="experience" class="chapter" data-story="0.25" aria-labelledby="experience-title">
        <img class="mobile-chapter-image" src="/images/pc-19/experience-mobile.webp" alt="The illustrative workstation with its glass side panel open." loading="lazy" width="700" height="700" />
        <div class="chapter-heading"><h2 id="experience-title">Experience</h2>
          <p class="section-intro">AI applications, backend systems,<br class="desktop-break" /> and full-stack development.</p></div>
        <div class="chapter-content">
          <div class="experience-list">
            {experience.map((item) => <article class="experience-entry">
              <div class="entry-meta"><p>{item.date}</p><p>{item.location}</p></div>
              <h3>{item.role}</h3><p class="organization">{item.organization}{item.detail && <span> · {item.detail}</span>}</p>
              <ul>{item.points.map((point) => <li>{point}</li>)}</ul>
              <p class="stack">{item.tools}</p>
            </article>)}
          </div>
        </div>
      </section>
      <section id="projects" class="chapter" data-story="0.5" aria-labelledby="projects-title">
        <img class="mobile-chapter-image" src="/images/pc-19/projects-mobile.webp" alt="Workstation components and the graphics card separated to show their construction." loading="lazy" width="700" height="700" />
        <div class="chapter-heading"><h2 id="projects-title">Selected <br />projects</h2>
          <p class="section-intro">Computer vision. Applied machine learning.</p></div>
        <div class="chapter-content" id="project-reading" data-story="0.6">
          <article class="project">
            <div class="project-title"><h3>Form-ulation</h3><a class="icon-link" href="https://devpost.com/software/form-ulation" target="_blank" rel="noopener noreferrer" aria-label="View Form-ulation on Devpost"><svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow} /></svg></a></div>
            <p class="project-context">Exercise-form analysis · CXC 2026 AI Hackathon</p>
            <p>A team project exploring real-time exercise feedback. YOLOv8 pose estimation identifies body joints, and a trained classifier uses the resulting features to distinguish good and poor exercise form.</p>
            <p class="stack">Python · YOLOv8 · OpenCV · scikit-learn · Snowflake</p>
            <div class="diagram" data-diagram="form" data-active-step="0">
              <div class="diagram-header"><span>Illustrative workflow</span><span>Exercise-form analysis</span></div>
              <svg class="workflow-svg" viewBox="0 0 600 200" role="img" aria-label="Video frames flow through pose estimation and classification into exercise feedback.">
                <path class="diagram-path" d="M124 94h49m-8-5 8 5-8 5M282 94h47m-8-5 8 5-8 5M438 94h36m-8-5 8 5-8 5" />
                <g class="form-video"><rect x="14" y="49" width="100" height="78" rx="4"/><rect x="23" y="40" width="100" height="78" rx="4"/><path d="m65 61 28 18-28 18z"/><path d="M24 144h99" /></g>
                <g class="form-pose"><rect x="182" y="40" width="90" height="104" rx="4"/><path d="M211 64h33M227 63v38m0-17-20 13m20-13 20 13m-20 4-16 25m16-25 16 25"/><circle cx="227" cy="54" r="6"/><circle cx="227" cy="83" r="3"/><circle cx="207" cy="97" r="3"/><circle cx="247" cy="97" r="3"/><circle cx="211" cy="126" r="3"/><circle cx="243" cy="126" r="3"/></g>
                <g class="form-classifier"><path d="m346 60 36 20 37-20m-73 34 36-14 37 14m-73 34 36-14 37 14m-73-68 36 54 37-54m-73 68 36-48 37 48"/>{[[346,60],[346,94],[346,128],[382,80],[382,114],[419,60],[419,94],[419,128]].map(([cx,cy])=><circle cx={cx} cy={cy} r="5" />)}</g>
                <g class="form-feedback"><rect x="483" y="40" width="100" height="104" rx="4"/><path d="m508 76 12 12 24-26M502 113h59M502 124h40"/></g>
                <text x="73" y="178" text-anchor="middle">INPUT</text><text x="227" y="178" text-anchor="middle">POSE</text><text x="382" y="178" text-anchor="middle">CLASSIFIER</text><text x="533" y="178" text-anchor="middle">FEEDBACK</text>
              </svg>
              <div class="diagram-controls" aria-label="Explore the Form-ulation workflow">{formSteps.map(([label],i)=><button type="button" data-step={i} aria-pressed={i===0}>{label}</button>)}</div>
              <div class="diagram-panels">{formSteps.map(([label,description],i)=><p data-step-panel={i}><strong>{label}.</strong> {description}</p>)}</div>
            </div>
            <a class="text-link" href="https://devpost.com/software/form-ulation" target="_blank" rel="noopener noreferrer">View project on Devpost <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a>
          </article>
          <article class="project">
            <div class="project-title"><h3>Computer Vision<br />Motion Detector</h3><a class="icon-link" href="https://github.com/Rgupta100/Pi-Motion-Camera" target="_blank" rel="noopener noreferrer" aria-label="View Motion Detector source on GitHub"><svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a></div>
            <p class="project-context">OpenCV image processing</p>
            <p>A headless camera application that uses running-average background subtraction to detect motion and capture timestamped images. Gaussian blur and frame differencing reduce noise, while a cooldown prevents duplicate events.</p>
            <p class="stack">Python · OpenCV · Raspberry Pi · Linux</p>
            <div class="diagram" data-diagram="motion" data-active-step="0">
              <div class="diagram-header"><span>Illustrative workflow</span><span>Background subtraction</span></div>
              <svg class="workflow-svg motion-svg" viewBox="0 0 600 220" role="img" aria-label="A reference frame is compared with a changed frame, highlighting motion before saving an event.">
                <g class="motion-reference"><rect x="18" y="34" width="168" height="126" rx="4"/><path d="M18 133h168M47 134V87h38v47M124 134V60h32v74"/><text x="102" y="192" text-anchor="middle">BACKGROUND</text></g>
                <g class="motion-detected"><rect x="216" y="34" width="168" height="126" rx="4"/><path d="M216 133h168M245 134V87h38v47M322 134V60h32v74"/><rect class="detected-object" x="282" y="91" width="25" height="40"/><path class="detection-bound" d="M272 88V80h12m15 0h17v8m0 44v9h-13m-18 0h-13v-9"/><text x="300" y="192" text-anchor="middle">FRAME DIFFERENCE</text></g>
                <g class="motion-captured"><rect x="414" y="34" width="168" height="126" rx="4"/><rect x="432" y="52" width="132" height="86" rx="2"/><path d="M442 125h109m-96 0V85h25v40m42 0V65h20v60"/><path class="capture-check" d="m483 82 10 10 20-23"/><text x="498" y="192" text-anchor="middle">SAVED EVENT</text></g>
              </svg>
              <div class="diagram-controls" aria-label="Explore motion detection">{motionSteps.map(([label],i)=><button type="button" data-step={i} aria-pressed={i===0}>{label}</button>)}</div>
              <div class="diagram-panels">{motionSteps.map(([label,description],i)=><p data-step-panel={i}><strong>{label}.</strong> {description}</p>)}</div>
            </div>
            <a class="text-link" href="https://github.com/Rgupta100/Pi-Motion-Camera" target="_blank" rel="noopener noreferrer">View source on GitHub <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a>
          </article>
        </div>
      </section>
      <section id="skills" class="chapter" data-story="0.75" aria-labelledby="skills-title">
        <img class="mobile-chapter-image" src="/images/pc-19/skills-mobile.webp" alt="A close view of the workstation motherboard and processor." loading="lazy" width="700" height="700" />
        <div class="chapter-heading"><h2 id="skills-title">Technical<br />background</h2>
          <p class="section-intro">Tools used across internships and projects.</p></div>
        <div class="chapter-content">
          <dl class="skills-list">{skills.map(([label,tools])=><div><dt>{label}</dt><dd>{tools}</dd></div>)}</dl>
          <div class="education"><h3>University of Waterloo</h3><p>BASc, Computer Engineering (Co-op)</p><p class="entry-meta">September 2025–May 2030 (expected)</p><p>Relevant coursework includes Data Structures &amp; Algorithms and Digital Computer Systems.</p></div>
          <div class="credentials"><h3>Certifications &amp; learning</h3><ul><li><h4>Agentic AI Foundations Associate</h4><p>Oracle Cloud Infrastructure · 2026</p></li><li><h4>Generative AI, LLMs &amp; Responsible AI</h4><p>Google Cloud courses · 2026</p></li><li><h4>Certified Fundamentals in Cybersecurity</h4><p>Fortinet · 2025, valid through 2027</p></li></ul></div>
        </div>
      </section>
      <section id="contact" class="chapter contact" data-story="1" aria-labelledby="contact-title">
        <img class="mobile-chapter-image" src="/images/pc-19/contact-mobile.webp" alt="The illustrative workstation reassembled." loading="lazy" width="700" height="700" />
        <div class="chapter-heading"><h2 id="contact-title">Contact</h2><p class="section-intro">For AI engineering and software<br class="desktop-break" /> development opportunities.</p></div>
        <div class="chapter-content"><p class="contact-availability">{profile.availability}</p>
          <div class="email-row"><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a><button id="copy-email" type="button" aria-label="Copy email address" data-email={profile.email}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 7h10v10H7zM3 13V3h10"/></svg></button></div><p id="copy-status" role="status" aria-live="polite"></p>
          <div class="social-links"><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a><a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrow}/></svg></a></div>
        </div>
      </section>
    </main>
    <aside id="pc-controls" aria-label="Explore the computer" hidden>
      <details id="pc-explore">
        <summary>Explore the computer <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-6-6v12" /></svg></summary>
        <div class="pc-control-panel">
          <label for="pc-view">Computer view</label>
          <select id="pc-view"><option value="0">Assembled</option><option value="0.25">Open case</option><option value="0.5">Disassembled GPU</option><option value="0.75">Processor close-up</option><option value="1">Reassembled</option></select>
          <div class="pc-control-actions"><button id="pc-play" type="button">Play sequence</button><button id="pc-fans" type="button">Pause fans</button></div>
          <label for="pc-lighting">Lighting</label>
          <select id="pc-lighting"><option value="rgb">RGB story</option><option value="studio">Studio</option><option value="off">Emission off</option></select>
          <button id="pc-return" type="button" hidden>Return to portfolio <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5" /></svg></button>
        </div>
      </details>
      <p id="pc-control-status" class="sr-only" role="status" aria-live="polite"></p>
    </aside>
    <footer class="site-footer"><p>Raghav Gupta<span>Waterloo, Ontario</span></p><p class="asset-credit">Illustrative workstation created for this portfolio.</p><a href="#overview">Back to top <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 17V3m-5 5 5-5 5 5" /></svg></a></footer>
    <noscript><style>#pc-stage canvas{display:none}#pc-controls,#pc-motion,#copy-email,.diagram-controls{display:none!important}@media(min-width:1000px){#pc-stage{position:absolute;height:100svh}.mobile-chapter-image{display:block;width:100%;height:60vh;object-fit:contain;margin-bottom:45px}#experience .chapter-heading,#experience .chapter-content,#skills .chapter-heading,#skills .chapter-content,.contact .chapter-heading,.contact .chapter-content,#project-reading{margin-left:auto;margin-right:auto;width:100%;max-width:800px;background:none}#project-reading{margin-top:60px}}</style></noscript>
    <script>import '../scripts/pc-main.ts';</script>
  </body>
</html>

